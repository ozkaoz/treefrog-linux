# treefrog-linux: config fragment for the kernel-only bring-up experiment
#
# PURPOSE: SD limpia + SOLO nuestro kernel con initramfs propio (busybox-free:
# single static diagnostic init). NO stock OS, NO TreeFrogUI payload.
#
# Basis (evidence):
#   - vendor kernel-initramfs.config (SDK 2024.02.y.2) uses
#     CONFIG_BLK_DEV_INITRD=y + INITRAMFS_SOURCE=rootfs.cpio + MIPS_ELF_APPENDED_DTB
#     for its initramfs variant — we mirror that exact scheme.
#   - vendor kernel-squashfs.config (our base so far) has INITRD off and fbcon off.
#   - The stock R36SX DTB (which we deploy unmodified) defines stdout-path
#     serial0:115200n8 (virtuart via AVP) and console=tty1 in bootargs; VT_CONSOLE
#     is already =y in the base config. fbcon lets the kernel+init write to the
#     panel WITHOUT any stock driver/app in the loop.
#
# Every line maps to the experiment design documented in
# docs/test-runs/2026-09-10_XXXX_r36sx-kernelonly.md (see repo docs).

# --- initramfs: our own cpio, gzip (RD_GZIP already in base) ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_INITRAMFS_COMPRESSION_GZIP=y

# --- DTB: embebido en la seccion .appended_dtb del vmlinux ELF (esquema de la
#     variante vendor kernel-initramfs: MIPS_ELF_APPENDED_DTB crea la seccion
#     VACIA en el link, y objcopy --update-section la rellena -> -O binary
#     la incluye porque es allocatable) ---
CONFIG_MIPS_ELF_APPENDED_DTB=y

# --- framebuffer console so /dev/console messages appear on the panel ---
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# --- input API used by the diagnostic init (probe /dev/input/js*) ---
CONFIG_INPUT_JOYDEV=y
