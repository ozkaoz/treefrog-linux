# treefrog-linux R36SX config fragment — variante treefrog (initramfs PROPIO, FASE F)
#
# PURPOSE: arrancar con NUESTRO init (rootfs/treefrog/linuxrc) que lanza FrogUI
# DIRECTO, sin icube/rkgame/zhijack del firmware stock. Es el paso FASE F del
# plan (§25): initramfs mínimo propio → independencia del init stock.
#
# EVIDENCE:
#   - R30/R31/R32: k4 (initramfs stock + joydev + check_adc) = boot estable.
#   - Blueprint del linuxrc propio: cubegm/zhijack.sh de la SD (receta probada
#     en tests #9/#10: 118k+ frames, navegación, batería OK) + S99app stock
#     (bind-mounts SD) + S41hcdaemon (hcdaemon&) + S10mdev (mdev).
#   - Componentes reutilizados del initramfs stock (busybox, lib/, hcdaemon,
#     hotplug_helper): scripts/build-initramfs.sh los reempaqueta; NO se
#     redistribuyen fuentes — el usuario ya los tiene en su firmware/SD.
#   - cubevol vive en la SD (rootfs/usr/bin/), no en el ramdisk (S99app lo
#     bindea); linuxrc lo lanza desde /mnt/sdcard tras montar.
#
# Regla: cada línea mapea a evidencia documentada. No añadir opciones especulativas.

# --- input: joystick API para cubevol (/dev/input/jsN) --------------------------
CONFIG_INPUT_JOYDEV=y

# --- bateria: driver check-adc (esquema stock) -----------------------------------
# (R31/test #10: sin /dev/check_adc1/5, driver.so lee 0% -> poweroff)
CONFIG_CHECK_ADC=y

# --- initramfs PROPIO (FASE F, quirúrgico R36) -----------------------------------
# R36: el cpio REGENERADO (cpio --null -o) mataba el boot pre-init con k5-k8
# (kernel idéntico al golden; única variable el cpio). Se usa CIRUGÍA BINARIA
# del cpio stock (treefrog-initramfs-surgical.cpio): TODO byte-idéntico al
# stock que bootea (k3/k4), SOLO se reemplaza el contenido de /init por el
# linuxrc TreeFrog v3. Elimina toda diferencia estructural (uid ., links,
# pads, order) como variable.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/mnt/d/GitHub/treefrog-linux/build/treefrog-initramfs-surgical.cpio"
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_RD_GZIP=y
