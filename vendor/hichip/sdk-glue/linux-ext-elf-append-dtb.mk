
LINUX_APPEND_DTB += \
	$(TARGET_OBJCOPY) --update-section .appended_dtb=$(LINUX_ARCH_PATH)/boot/dts/$(LINUX_DTBS) $(LINUX_IMAGE_PATH); \
	$(TARGET_OBJCOPY) -O binary $(LINUX_IMAGE_PATH) $(BINARIES_DIR)/vmlinux.bin;

define LINUX_INSTALL_IMAGES_DTB
	install -m 0775 $(LINUX_ARCH_PATH)/boot/dts/$(LINUX_DTBS) $(BINARIES_DIR)/dtb.bin
endef
LINUX_POST_INSTALL_IMAGES_HOOKS += LINUX_INSTALL_IMAGES_DTB
