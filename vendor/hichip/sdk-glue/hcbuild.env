
function submodule()
{
	local cmd=$1
	local sub=""

	if [ $# -eq 0 ]; then
		echo "Error input parameter! Please run:";
		echo -e "\tsubmodule update";
		return;
	fi

	if [ $# -eq 1 ]; then
		cmd=$1
	fi

	if [ $# -eq 2 ]; then
		cmd=$1
		sub=$(git submodule  | grep $2 | awk '{print $2}')
	fi

	if [ "$cmd" == "update" ]; then
		if [ "$sub" == "" ]; then
			git submodule update --init --recursive
			return;
		else
			git submodule update --init --recursive $sub
			return;
		fi
	fi
}

function hcbuild()
{
	local module=""
	local ncomponents=0
	local components=""
	local tmp=""
	local cmds=""

	if [ $# -eq 0 ]; then
		echo "Error input parameter! Please run:";
		echo -e "\thcbuild linux";
		echo -e "\thcbuild hcboot";
		echo -e "\thcbuild avp";
		echo -e "\thcbuild lvgl";
		return;
	fi

	while [ $# != 0 ]; do
		module=$(echo $1 | sed 's#/$##')
		shift

		if [ "$module" == "all" ]; then
			continue
		fi

		if [ "$module" == "linux" ]; then
			cmds="$cmds linux-rebuild"
			continue
		fi

		if [ "$module" == "dts" ]; then
			cmds="$cmds hcboot-kernel-rebuild hcboot-all hcboot-rebuild linux-rebuild"
			continue
		fi

		if [ "$module" == "hcboot" ]; then
			while [ $# != 0 ]; do
				tmp=$1
				if [ ${tmp:0:1} == "-" ]; then
					components="$components hcboot-${tmp:1}-rebuild"
					((ncomponents++))
					shift
				else
					break
				fi
			done
			if [ $ncomponents == 0 ]; then
				cmds="$cmds hcboot-dirclean hcboot"
			else
				cmds="$cmds $components hcboot-all hcboot-rebuild"
			fi
			continue
		fi

		if [ "$module" == "avp" ]; then
			while [ $# != 0 ]; do
				tmp=$1
				if [ ${tmp:0:1} == "-" ]; then
					components="$components avp-${tmp:1}-rebuild"
					((ncomponents++))
					shift
				else
					break
				fi
			done
			if [ $ncomponents == 0 ]; then
				cmds="$cmds avp-dirclean avp"
			else
				cmds="$cmds $components avp-all avp-rebuild"
			fi
			continue
		fi

		cmds="$cmds $module-rebuild"
	done

	make -C buildroot $cmds all
	return;
}

function hcconfig()
{
	local module=""
	local subcmd=""
	local lastdefconfig=""
	local linux_override=""
	local linux_configfile=""
	local linux_version=""

	if [ $# -eq 0 ]; then
		make -C buildroot menuconfig
		return;
	fi

	if [ $# -eq 1 ]; then
		module=$(echo $1 | sed 's#/$##')
	fi

	if [ $# -eq 1 ] && [ "$1" == "savedefconfig" ]; then
		make -C buildroot savedefconfig
		return;
	fi

	if [ $# -eq 2 ] && [ "$1" == "savedefconfig" ]; then
		module=$(echo $2 | sed 's#/$##')
		if [ "$module" == "linux" ]; then
			linux_override=$(cat buildroot/.config | grep "BR2_LINUX_KERNEL_OVERRIDE_SOURCE=y")
			if [ "$linux_override" == "" ]; then
				linux_version=$(cat buildroot/.config | grep BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE | awk -F '"' '{print $2}')
				linux_configfile=$(cat buildroot/.config | grep BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE | \
					   awk -F '"' '{print $2}' | \
					   sed 's#$(BR2_EXTERNAL_HCLINUX_PATH)/##' | \
					   sed "s#\$(LINUX_VERSION)#$linux_version#")
				cp -vf buildroot/output/build/linux-$linux_version/.config $linux_configfile
			else
				linux_configfile=$(cat buildroot/.config | grep BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE | \
					   awk -F '"' '{print $2}' | \
					   sed 's#$(BR2_EXTERNAL_HCLINUX_PATH)/##' | \
					   sed "s#\$(LINUX_VERSION)#custom#")
				cp -vf buildroot/output/build/linux-custom/.config $linux_configfile
			fi
			return;
		fi

		if [ "$module" == "hcboot" ]; then
			lastdefconfig=$(ls buildroot/output/build/hcboot-custom/output/.*_defconfig 2>/dev/null | awk -F '.' '{print $2}')
			cp -vf buildroot/output/build/hcboot-custom/output/.config SOURCE/avp/configs/$lastdefconfig
			return;
		fi

		if [ "$module" == "avp" ]; then
			lastdefconfig=$(ls buildroot/output/build/avp-custom/output/.*_defconfig 2>/dev/null | awk -F '.' '{print $2}')
			cp -vf buildroot/output/build/avp-custom/output/.config SOURCE/avp/configs/$lastdefconfig
			return;
		fi

		echo "Not support savedefconfig for package $module"
		return;
	fi

	if [ "$module" == "linux" ]; then
		make -C buildroot linux-menuconfig
		make -C buildroot linux-rebuild all
		return;
	fi

	if [ "$module" == "avp" ]; then
		make -C buildroot avp-menuconfig
		make -C buildroot avp-kernel-rebuild avp-all avp-rebuild all
		return;
	fi

	if [ "$module" == "hcboot" ]; then
		make -C buildroot hcboot-menuconfig
		make -C buildroot hcboot-kernel-rebuild hcboot-all hcboot-rebuild all
		return;
	fi

	if [ "$module" == "busybox" ]; then
		make -C buildroot busybox-menuconfig
		make -C buildroot busybox-rebuild all
		return;
	fi
}

function get_board()
{
	declare -a hcboards
	declare -a hcboards_short
	local query="$1"
	local n
	local b
	local idx
	local i
	((n=0))
	for b in $(ls configs); do
		hcboards[$n]=$b
		hcboards_short[$n]=$(echo $b | sed 's/hichip_hc16xx_db_//' | sed 's/_defconfig//');
		((n++))
	done
	while /bin/true ; do
		echo "${query} "
		for ((i=0;i<n;i++)); do
			echo -e "${hcboards_short[$i]} \t[$i]"
		done
		echo -n "==> "
		read idx
		if [ "$idx" = "" ]; then
			if [ "$HCBOARD" == "" ]; then
				continue
			else
				echo "The board is not changed"
				answer=$HCBOARD
				return;
			fi
		fi

		if [ -f configs/${hcboards[$idx]} ]; then
			answer=${hcboards[$idx]}
			return;
		else
			echo "Sorry, the board ${hcboards_short[$idx]} is not supported"
		fi
	done
}

if [ -f .hcbuild.env ] ; then
	source .hcbuild.env
else
	touch .hcbuild.env
fi

get_board "Please select the board [ current is $(echo $HCBOARD |sed 's/hichip_hc16xx_db_//' | sed 's/_defconfig//') ]"
HCBOARD="${answer}"
sed -i -e "/\\<HCBOARD=\\>/d" .hcbuild.env
echo "HCBOARD=${HCBOARD}" > .hcbuild.env

echo "BOARD defconfig is using configs/${HCBOARD}"

make -C buildroot BR2_EXTERNAL=$PWD $HCBOARD
