	panel-init-sequence = [
		39 00 04 B9 FF 83 99
		39 00 0D B1 00 64 39 3B 44 09 22 22 71 F1 54 5E
		39 00 0B B2 00 80 00 7F 0A 0E 30 4D 01 01
