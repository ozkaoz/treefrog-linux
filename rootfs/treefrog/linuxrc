#!/bin/sh
# treefrog-linux linuxrc v3 — FASE F + forense por pasos
#
# v3: tras test #11/#12 (0 escrituras SD con init propio; k4 stock-init OK),
# el init propio moría pre-picoarch SIN traza. Esta version traza cada paso
# a la SD (montada manualmente aqui, sin depender de mdev) con sync por paso:
# el ULTIMO paso en /mnt/sdcard/tf-trace.txt = punto exacto de muerte.
# Ademas: si el fb esta usable, pinta el numero de paso en pantalla.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
T=/mnt/sdcard/tf-trace.txt   # se activa cuando la SD se monta (paso 7)

# --- P01: filesystems base -----------------------------------------------------
/bin/busybox mkdir -p /dev/pts /dev/shm /proc /sys /tmp /run /media/sd1 /mnt/sdcard
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t tmpfs tmpfs /tmp
/bin/busybox mount -t tmpfs tmpfs /run
/bin/busybox mount -t devpts devpts /dev/pts -o gid=5,mode=620,ptmxmode=0666
/bin/busybox mount -t tmpfs tmpfs /dev/shm -o mode=0777

TRACE=/run/trace.txt
echo "P01 fs-base ok" > $TRACE

# --- P02: consola --------------------------------------------------------------
if (/bin/busybox exec 0</dev/console) 2>/dev/null; then
    /bin/busybox exec 0</dev/console
    /bin/busybox exec 1>/dev/console
    /bin/busybox exec 2>/dev/console
fi
echo "P02 console ok" >> $TRACE

# --- P03: hcdaemon (AMPRPC -> AVP) ---------------------------------------------
/usr/bin/hcdaemon &
echo "P03 hcdaemon ok" >> $TRACE

# --- P04: detectar particion SD (sin mdev: directa de /dev) --------------------
SDDEV=""
for n in 1 2 3 4; do
    for d in mmcblk0p$n mmcblk1p$n; do
        [ -b /dev/$d ] && SDDEV=/dev/$d && break
    done
    [ -n "$SDDEV" ] && break
done
[ -z "$SDDEV" ] && SDDEV=/dev/mmcblk0p1
echo "P04 sddev=$SDDEV" >> $TRACE

# --- P05: montar la SD DIRECTAMENTE (vfat) --------------------------------------
if /bin/busybox mount -t vfat -o iocharset=utf8 $SDDEV /media/sd1; then
    echo "P05 mount vfat ok" >> $TRACE
else
    echo "P05 mount vfat FALLO, probando auto" >> $TRACE
    /bin/busybox mount -t auto $SDDEV /media/sd1 || echo "P05 auto FALLO" >> $TRACE
fi

# --- P06: bind como S99app + traza visible en SD --------------------------------
if [ -e /media/sd1/cubegm/icube ]; then
    /bin/busybox mount --bind /media/sd1 /mnt/sdcard
    echo "P06 bind ok" >> $TRACE
else
    echo "P06 SIN cubegm (SD mal montada?)" >> $TRACE
    /bin/busybox sleep 20   # ventana para apagar y no quemar SD
    /bin/busybox reboot -f
fi

# traza a la SD (persistente)
/bin/busybox cat $TRACE > /mnt/sdcard/tf-trace.txt
TRACE=/mnt/sdcard/tf-trace.txt
echo "P07 traza-en-SD ok" >> $TRACE
/bin/busybox sync

# --- P08: swap (como S99app stock) ----------------------------------------------
if [ -f /mnt/sdcard/cubegm/pagefile.sys ]; then
    /bin/busybox swapon /mnt/sdcard/cubegm/pagefile.sys 2>>$TRACE
    /bin/busybox free | /bin/busybox grep -i swap >> $TRACE
    echo "P08 swapon intentado" >> $TRACE
    /bin/busybox sync
fi

# --- P09: rootfs de la SD (como S99app completo) ----------------------------------
MNTDIR=/media/sd1
if [ -d $MNTDIR/rootfs ]; then
    for sub in lib usr bin sbin etc hcdemo_files; do
        [ -d $MNTDIR/rootfs/$sub ] && /bin/busybox mount --bind $MNTDIR/rootfs/$sub /$sub
    done
    echo "P09 rootfs binds ok" >> $TRACE
fi

# --- P10: hotplug+mdev LUEGO de montar (para USB futuro) --------------------------
/bin/busybox echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null
/bin/busybox mdev -s 2>/dev/null
echo "P10 mdev ok" >> $TRACE

# --- P11: cubevol (input gpio -> /tmp/joy_key) -------------------------------------
CV=/mnt/sdcard/rootfs/usr/bin/cubevol
[ -x "$CV" ] && "$CV" &
echo "P11 cubevol ($CV)" >> $TRACE

# --- P12: CPU performance ----------------------------------------------------------
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -w "$g" ] && /bin/busybox echo performance > "$g"
done
echo "P12 cpufreq ok" >> $TRACE

# --- P13: env TreeFrogUI -----------------------------------------------------------
cat > /tmp/tfdevice.env <<EOF
TF_DEVICE=R36SX
TF_PANEL_W=640
TF_PANEL_H=480
TF_UI_SCALE=150
TF_ASPECT_NUM=4
TF_ASPECT_DEN=3
TF_ROTATE=0
TF_PRESENT=fbwrite
TF_DRIVER=/mnt/sdcard/cubegm/driver_r36sx.so
EOF
. /tmp/tfdevice.env
export TF_DEVICE TF_PANEL_W TF_PANEL_H TF_UI_SCALE TF_DRIVER
export LD_LIBRARY_PATH=/mnt/sdcard/cubegm/lib:/mnt/sdcard/cubegm/usr/lib
echo "P13 env ok" >> $TRACE
/bin/busybox sync

# --- LOOP: FrogUI directo -------------------------------------------------------------
PICOARCH=/mnt/sdcard/cubegm/picoarch
PICOARCH_HI=/mnt/sdcard/cubegm/picoarch_hi
FROGUI_CORE=/mnt/sdcard/cubegm/cores/frogui_libretro.so
LAUNCH=/tmp/frogui_launch.txt

/bin/busybox free >> $TRACE
echo "=== LOOP frogui (init v3) ===" >> $TRACE
/bin/busybox sync

ITER=0
while :; do
    ITER=$((ITER+1))
    /bin/busybox rm -f "$LAUNCH"
    echo "L iter $ITER frogui" >> $TRACE
    "$PICOARCH" "$FROGUI_CORE" "$FROGUI_CORE" >> /tmp/treefrog_ui.log 2>&1
    RC=$?
    echo "L frogui rc=$RC" >> $TRACE
    /bin/busybox tail -5 /tmp/treefrog_ui.log >> $TRACE 2>/dev/null
    /bin/busybox sync
    [ "$ITER" -ge 5 ] && { echo "L 5 muertes: STOP" >> $TRACE; /bin/busybox sleep 60; }

    [ -f "$LAUNCH" ] || { /bin/busybox sleep 1; continue; }
    KIND=$(/bin/busybox sed -n 1p "$LAUNCH")
    if [ "$KIND" = standalone ]; then
        BIN_PATH=$(/bin/busybox sed -n 2p "$LAUNCH")
        ARG_PATH=$(/bin/busybox sed -n 3p "$LAUNCH")
        /bin/busybox rm -f "$LAUNCH"
        /bin/busybox sleep 0.3
        echo "L iter $ITER standalone $BIN_PATH" >> $TRACE
        [ -n "$ARG_PATH" ] && "$BIN_PATH" "$ARG_PATH" >> /tmp/treefrog_ui.log 2>&1 || "$BIN_PATH" >> /tmp/treefrog_ui.log 2>&1
        /bin/busybox sleep 0.2
        continue
    fi
    CORE_PATH=$(/bin/busybox sed -n 1p "$LAUNCH")
    ROM_PATH=$(/bin/busybox sed -n 2p "$LAUNCH")
    /bin/busybox rm -f "$LAUNCH"
    if [ -n "$CORE_PATH" ] && [ -n "$ROM_PATH" ]; then
        /bin/busybox sleep 0.3
        BIN="$PICOARCH"
        case "$CORE_PATH" in
            *gpsp*|*pcsx*|*ps1*|*ppsspp*) [ -f "$PICOARCH_HI" ] && BIN="$PICOARCH_HI" ;;
        esac
        echo "L iter $ITER game $CORE_PATH via $BIN" >> $TRACE
        "$BIN" "$CORE_PATH" "$ROM_PATH" >> /tmp/treefrog_ui.log 2>&1
        echo "L game rc=$?" >> $TRACE
    fi
    /bin/busybox sleep 0.2
done
